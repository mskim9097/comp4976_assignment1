flowchart LR
  subgraph App["iPhone / iPad - SwiftUI app (MVVM)"]
    direction LR
    Views["Views<br/>SwiftUI, adaptive layouts"] --> VM["ViewModels<br/>@Observable, async/await,<br/>validation rules"]
    VM --> ApiSvc["API services<br/>URLSession + Codable<br/>JWT in the Keychain"]
    VM --> FbSvc["Firebase services<br/>Auth + Firestore SDK"]
  end

  subgraph Azure["Azure App Service"]
    direction TB
    WebApi["ASP.NET Core Web API<br/>JWT login, ?city= filter"] --> SQL[("SQLite database")]
  end

  subgraph Firebase["Firebase"]
    direction TB
    FAuth["Authentication<br/>email + password"]
    Store[("Cloud Firestore<br/>CandidateSelections, Users")]
  end

  ApiSvc -->|"HTTPS + JSON (JWT)"| WebApi
  FbSvc -->|Firebase SDK| FAuth
  FbSvc -->|"Firebase SDK + security rules"| Store

  classDef app fill:#edf7f1,stroke:#2d6a4f,stroke-width:2px;
  classDef az fill:#eef4fc,stroke:#1f4e8c,stroke-width:2px;
  classDef fb fill:#fff5e8,stroke:#b86b12,stroke-width:2px;
  class Views,VM app
  class ApiSvc,WebApi,SQL az
  class FbSvc,FAuth,Store fb
