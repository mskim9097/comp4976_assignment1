        EF["EF Core (Code First)"]
        DB[("SQLite<br/>/home/data/api.db")]
        Img["Static images<br/>wwwroot/images"]
        Auth --> Ctl --> EF --> DB
    end

    Svc -- "HTTPS + JSON<br/>Authorization: Bearer token" --> Auth
    Svc -. "HTTPS image URLs" .-> Img

