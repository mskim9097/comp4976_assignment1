erDiagram
    AspNetUsers {
        string Id PK
        string UserName
        string Email
        string Name
    }
    AspNetRoles {
        string Id PK
        string Name
    }
    AspNetUserRoles {
        string UserId PK, FK
        string RoleId PK, FK
    }
    Municipality {
        int Id PK
        string Name
        string Slug UK
        string Province
        datetime ElectionDate
        string Description
        string LogoFileName
        string AdminRoleName
    }
    Position {
        int Id PK
        string Name
        int SeatsAvailable
        int MunicipalityId FK
    }
    Candidate {
        int Id PK
        string Name
        string Profile
        string PhotoFileName
        string Website
        string Email
        datetime CreatedDate
        int PositionId FK
    }

    AspNetUsers ||--o{ AspNetUserRoles : "belongs to"
    AspNetRoles ||--o{ AspNetUserRoles : "has members"
    AspNetRoles ||..o| Municipality : "admin role name"
    Municipality ||--o{ Position : "has"
    Position ||--o{ Candidate : "has"
