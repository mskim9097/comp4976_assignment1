erDiagram
  direction LR
  Municipalities ||--o{ Positions : has
  Positions ||--o{ Candidates : has
  Municipalities ||--o{ Candidates : "tenant"
  Municipalities |o--o{ AspNetUsers : "administers"
  AspNetUsers ||--o{ AspNetUserRoles : has
  AspNetRoles ||--o{ AspNetUserRoles : has

  Municipalities {
    int MunicipalityId PK
    string Name UK
    string Slug UK
    string Province
    date ElectionDate
    string Description
    string LogoFileName
    string ThemeColor
    string WelcomeMessage
  }
  Positions {
    int PositionId PK
    string Name
    int SeatsAvailable
    int MunicipalityId FK "tenant"
  }
  Candidates {
    int CandidateId PK
    string Name
    string Profile
    string PhotoFileName
    string Website
    string Email
    datetime CreatedDate
    int PositionId FK
    int MunicipalityId FK "tenant"
  }
  AspNetUsers {
    string Id PK
    string UserName
    string Email
    string Name
    int MunicipalityId FK "tenant, null for Super Admin"
  }
  AspNetRoles {
    string Id PK
    string Name
  }
  AspNetUserRoles {
    string UserId PK, FK
    string RoleId PK, FK
  }
