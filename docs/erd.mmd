erDiagram
    direction LR
    AspNetUsers {
        string Id PK
        string UserName
        string Email
        string PasswordHash
        string Name
    }
    AspNetUserRoles {
        string UserId PK, FK
        string RoleId PK, FK
    }
    AspNetRoles {
        string Id PK
        string Name
    }
    Municipality {
        int MunicipalityId PK
        string Name UK
        string Province
        date ElectionDate
        string Description
        string LogoFileName
        string AdminRoleName
    }
    Position {
        int PositionId PK
        string Name "unique per municipality"
        int SeatsAvailable
        int MunicipalityId FK
    }
    Candidate {
        int CandidateId PK
        string Name
        string Profile
        string PhotoFileName
        string Website
        string Email
        datetime CreatedDate
        int PositionId FK
    }
    SavedCandidate {
        int SavedCandidateId PK
        string UserId FK "unique with CandidateId"
        int CandidateId FK
        datetime DateSaved
    }
    AspNetUsers ||--o{ AspNetUserRoles : "belongs to"
    AspNetRoles ||--o{ AspNetUserRoles : "has members"
    AspNetRoles ||..o| Municipality : "admin group (by name)"
    Municipality ||--o{ Position : "has (cascade)"
    Position ||--o{ Candidate : "has (cascade)"
    AspNetUsers ||--o{ SavedCandidate : "saves (cascade)"
    Candidate ||--o{ SavedCandidate : "saved as (cascade)"
