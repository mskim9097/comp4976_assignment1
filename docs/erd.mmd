erDiagram
    AspNetUsers {
        string Id PK
        string UserName
        string Email
        string PasswordHash
        string Name
    }
    AspNetRoles {
        string Id PK
        string Name
    }
    AspNetUserRoles {
        string UserId PK, FK
        string RoleId PK, FK
    }
    Municipality {
        int MunicipalityId PK
        string Name
        string Province
        date ElectionDate
        string Description
        string LogoFileName
        string AdminRoleName
    }
    Position {
        int PositionId PK
        string Name
        int SeatsAvailable
        int MunicipalityId FK
    }
    Candidate {
        int CandidateId PK
        string Name
        string Profile
        string PhotoFileName
        string Website
        string Email
        datetime CreatedDate
        int PositionId FK
    }
    SavedCandidate {
        int SavedCandidateId PK
        string UserId FK
        int CandidateId FK
        datetime DateSaved
    }

    AspNetUsers ||--o{ AspNetUserRoles : "belongs to"
    AspNetRoles ||--o{ AspNetUserRoles : "has members"
    AspNetRoles ||..o| Municipality : "admin group (AdminRoleName)"
    Municipality ||--o{ Position : "has"
    Position ||--o{ Candidate : "has"
    AspNetUsers ||--o{ SavedCandidate : "saves"
    Candidate ||--o{ SavedCandidate : "is saved as"
