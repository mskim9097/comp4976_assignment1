@model MunicipalityAdminDashboardViewModel
@{
    ViewData["Title"] = "Municipality Admin";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1>Municipality Admin</h1>
        <p class="text-muted mb-0">Manage positions and candidates for your municipality.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="CreateCandidate">Add candidate</a>
        <a class="btn btn-primary" asp-action="CreatePosition">Add position</a>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (Model.Municipalities.Count == 0)
{
    <div class="alert alert-info">Your account is not assigned to a municipality. Contact a Super Admin for access.</div>
}
else
{
    @foreach (var municipality in Model.Municipalities)
    {
        <section class="mb-5" aria-labelledby="municipality-@municipality.Municipality.MunicipalityId">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div>
                    <h2 id="municipality-@municipality.Municipality.MunicipalityId" class="h3 mb-1">
                        @municipality.Municipality.Name
                    </h2>
                    <div class="text-muted">@municipality.Municipality.Province · Election date: @municipality.Municipality.ElectionDate.ToString("yyyy-MM-dd")</div>
                </div>
                <a class="btn btn-sm btn-outline-primary"
                   asp-action="CreatePosition" asp-route-municipalityId="@municipality.Municipality.MunicipalityId">
                    Add position
                </a>
            </div>

            @if (municipality.Positions.Count == 0)
            {
                <div class="alert alert-light border">No positions have been added for this municipality yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th scope="col">Position</th>
                                <th scope="col">Seats</th>
                                <th scope="col">Candidates</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in municipality.Positions)
                        {
                            <tr>
                                <th scope="row">@item.Position.Name</th>
                                <td>@item.Position.SeatsAvailable</td>
                                <td>
                                    @if (item.Candidates.Count == 0)
                                    {
                                        <span class="text-muted">None</span>
                                    }
                                    else
                                    {
                                        <ul class="list-unstyled mb-0">
                                        @foreach (var candidate in item.Candidates)
                                        {
                                            <li class="d-flex flex-wrap align-items-center gap-2">
                                                @if (!string.IsNullOrWhiteSpace(candidate.PhotoFileName))
                                                {
                                                    <img src="@Url.Content($"~/images/candidates/{Uri.EscapeDataString(candidate.PhotoFileName)}")"
                                                         alt="" class="rounded" style="width: 3rem; height: 3rem; object-fit: cover;" />
                                                }
                                                <span>@candidate.Name</span>
                                                <a class="btn btn-sm btn-outline-secondary"
                                                   asp-action="CandidateDetails" asp-route-id="@candidate.CandidateId">Details</a>
                                                <a class="btn btn-sm btn-outline-secondary"
                                                   asp-action="EditCandidate" asp-route-id="@candidate.CandidateId">Edit</a>
                                                <form asp-action="DeleteCandidate" asp-route-id="@candidate.CandidateId" method="post">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                                            onclick="return confirm('Delete this candidate?');">Delete</button>
                                                </form>
                                            </li>
                                        }
                                        </ul>
                                    }
                                    <a class="btn btn-sm btn-outline-primary mt-2"
                                       asp-action="CreateCandidate" asp-route-positionId="@item.Position.PositionId">
                                        Add candidate
                                    </a>
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-2">
                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-action="EditPosition" asp-route-id="@item.Position.PositionId">Edit</a>
                                        <form asp-action="DeletePosition" asp-route-id="@item.Position.PositionId" method="post">
                                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Delete this position? Positions with candidates cannot be deleted.');">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
}
