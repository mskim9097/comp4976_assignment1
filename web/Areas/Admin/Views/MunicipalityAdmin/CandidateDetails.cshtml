@model Candidate
@{
    ViewData["Title"] = Model.Name;
    var municipality = Model.Position!.Municipality!;
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="mb-1">@Model.Name</h1>
        <p class="text-muted mb-0">@Model.Position.Name &middot; @municipality.Name</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-action="EditCandidate" asp-route-id="@Model.CandidateId">Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back to list</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-md-4">
        @if (!string.IsNullOrWhiteSpace(Model.PhotoFileName))
        {
            <img src="@Url.Content($"~/images/candidates/{Uri.EscapeDataString(Model.PhotoFileName)}")"
                 alt="Photo of @Model.Name" class="img-fluid rounded w-100" style="max-height: 22rem; object-fit: cover;" />
        }
        else
        {
            <div class="border rounded d-flex align-items-center justify-content-center text-muted" style="height: 14rem;">No photo</div>
        }
    </div>
    <div class="col-12 col-md-8">
        <dl class="row">
            <dt class="col-sm-4">Municipality</dt>
            <dd class="col-sm-8">@municipality.Name</dd>
            <dt class="col-sm-4">Position</dt>
            <dd class="col-sm-8">@Model.Position.Name</dd>
            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Email) ? "-" : Model.Email)</dd>
            <dt class="col-sm-4">Website</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Website) ? "-" : Model.Website)</dd>
            <dt class="col-sm-4">Date created</dt>
            <dd class="col-sm-8">@Model.CreatedDate.ToString("yyyy-MM-dd HH:mm") UTC</dd>
        </dl>
        <h2 class="h5">Biography / Profile</h2>
        <p>@(string.IsNullOrWhiteSpace(Model.Profile) ? "No biography provided." : Model.Profile)</p>
    </div>
</div>
