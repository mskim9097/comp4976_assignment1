@model MunicipalityFormViewModel
@{
    var isEdit = Model.MunicipalityId != 0;
    ViewData["Title"] = isEdit ? "Edit Municipality" : "Add Municipality";
}

<h1>@ViewData["Title"]</h1>
<form asp-action="@(isEdit ? "EditMunicipality" : "CreateMunicipality")" method="post"
      enctype="multipart/form-data" class="mt-4" style="max-width: 42rem;">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <input asp-for="MunicipalityId" type="hidden" />
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" autocomplete="organization" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Province" class="form-label"></label>
        <input asp-for="Province" class="form-control" />
        <span asp-validation-for="Province" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ElectionDate" class="form-label"></label>
        <input asp-for="ElectionDate" class="form-control" />
        <span asp-validation-for="ElectionDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.CurrentLogoFileName))
    {
        <div class="mb-3">
            <label class="form-label">Current logo</label>
            <div>
                <img src="@Url.Content($"~/images/logos/{Uri.EscapeDataString(Model.CurrentLogoFileName)}")"
                     alt="Current logo for @Model.Name" class="img-thumbnail"
                     style="width: 10rem; height: 10rem; object-fit: contain;" />
            </div>
            <div class="form-text">Choose another image below to replace this logo.</div>
        </div>
    }
    <div class="mb-3">
        <label asp-for="LogoUpload" class="form-label"></label>
        <input asp-for="LogoUpload" class="form-control" type="file"
               accept=".png,.jpg,.jpeg,.gif,.webp,image/png,image/jpeg,image/gif,image/webp" />
        <span asp-validation-for="LogoUpload" class="text-danger"></span>
        <div class="form-text">Optional. PNG, JPEG, GIF, or WebP; maximum 5 MB.</div>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
