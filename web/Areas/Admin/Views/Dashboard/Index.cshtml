@model MunicipalElections.Web.Areas.Admin.Models.DashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="mb-4">
    <h1>Admin Dashboard</h1>
    <p class="text-muted mb-0">
        @if (Model.IsSuperAdmin)
        {
            <text>You manage all municipalities.</text>
        }
        else
        {
            <text>You manage: @string.Join(", ", Model.MunicipalityNames).</text>
        }
    </p>
</div>

<div class="row row-cols-1 row-cols-md-3 g-3 mb-4">
    <div class="col">
        <div class="card h-100 text-center">
            <div class="card-body">
                <div class="display-5 fw-bold" id="municipality-count">@Model.MunicipalityCount</div>
                <div class="text-muted">@(Model.MunicipalityCount == 1 ? "Municipality" : "Municipalities")</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 text-center">
            <div class="card-body">
                <div class="display-5 fw-bold" id="position-count">@Model.PositionCount</div>
                <div class="text-muted">@(Model.PositionCount == 1 ? "Position" : "Positions")</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 text-center">
            <div class="card-body">
                <div class="display-5 fw-bold" id="candidate-count">@Model.CandidateCount</div>
                <div class="text-muted">@(Model.CandidateCount == 1 ? "Candidate" : "Candidates")</div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-wrap gap-2">
    @if (Model.IsSuperAdmin)
    {
        <a class="btn btn-primary" asp-controller="SuperAdmin" asp-action="Index">Municipalities and administrators</a>
    }
    <a class="btn btn-@(Model.IsSuperAdmin ? "outline-primary" : "primary")" asp-controller="MunicipalityAdmin" asp-action="Index">Positions and candidates</a>
</div>
